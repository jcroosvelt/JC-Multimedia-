{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/article/:id", "destination": "/article.html" },
    { "source": "/boutique/:slug", "destination": "/article.html" },
    { "source": "/services/:slug", "destination": "/article.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}

{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/boutique",
      "destination": "/boutique.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/confidentialite",
      "destination": "/confidentialite.html"
    },
    {
      "source": "/conditions",
      "destination": "/conditions.html"
    },
    {
      "source": "/livraison",
      "destination": "/livraison.html"
    },
    {
      "source": "/suivi",
      "destination": "/suivi.html"
    },
    {
      "source": "/promotions",
      "destination": "/promotions.html"
    },
    {
      "source": "/retour-paiement",
      "destination": "/retour-paiement.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/article/:id",
      "destination": "/article.html"
    },
    {
      "source": "/boutique/:slug",
      "destination": "/article.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/article.html"
    },
    {
      "source": "/partage/:section/:slug",
      "destination": "/api/share?section=:section&slug=:slug"
    },
    {
      "source": "/payer/:token",
      "destination": "/payer.html"
    },
    {
      "source": "/sitemap-fiches.xml",
      "destination": "/api/sitemap-fiches"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://tkwrklboqspkzxtlvnzh.supabase.co; media-src 'self' blob: https://tkwrklboqspkzxtlvnzh.supabase.co; connect-src 'self' blob: https://tkwrklboqspkzxtlvnzh.supabase.co wss://tkwrklboqspkzxtlvnzh.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

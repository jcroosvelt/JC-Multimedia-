{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/boutique", "destination": "/boutique.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/confidentialite", "destination": "/confidentialite.html" },
    { "source": "/conditions", "destination": "/conditions.html" },
    { "source": "/livraison", "destination": "/livraison.html" },
    { "source": "/suivi", "destination": "/suivi.html" },
    { "source": "/retour-paiement", "destination": "/retour-paiement.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/article/:id", "destination": "/article.html" },
    { "source": "/boutique/:slug", "destination": "/article.html" },
    { "source": "/services/:slug", "destination": "/article.html" },
    { "source": "/partage/:section/:slug", "destination": "/api/share?section=:section&slug=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
